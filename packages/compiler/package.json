{
  "name": "@zshannon/scriptc-compiler",
  "version": "0.3.6",
  "description": "The scriptc compiler — TypeScript/JavaScript frontend, typed IR, LLVM backend",
  "license": "Apache-2.0",
  "homepage": "https://scriptc.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zshannon/scriptc.git",
    "directory": "packages/compiler"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./startup-cache": "./dist/startup-cache.js",
    "./scriptc.d.ts": "./ambient/scriptc.d.ts",
    "./scriptc-overrides.d.ts": "./ambient/scriptc-overrides.d.ts",
    "./scriptc-node-fallback.d.ts": "./ambient/scriptc-node-fallback.d.ts",
    "./surface-manifest.json": "./surface-manifest.json",
    "./cli/command": "./dist/cli/command.js",
    "./cli/host": "./dist/cli/host.js",
    "./cli/paths": "./dist/cli/paths.js",
    "./cli/output-options": "./dist/cli/output-options.js",
    "./cli/usage": "./dist/cli/usage.js",
    "./cli/wasi-runner": "./dist/cli/wasi-runner.js"
  },
  "files": [
    "dist",
    "ambient",
    "surface-manifest.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json"
  },
  "dependencies": {
    "@zshannon/scriptc-runtime": "workspace:*",
    "typescript": "7.0.2",
    "typescript5": "npm:typescript@5.9.3"
  },
  "optionalDependencies": {
    "@zshannon/scriptc-llvm-darwin-arm64": "workspace:*",
    "@zshannon/scriptc-llvm-darwin-x64": "workspace:*",
    "@zshannon/scriptc-llvm-linux-x64-gnu": "workspace:*",
    "@zshannon/scriptc-llvm-linux-arm64-gnu": "workspace:*",
    "@zshannon/scriptc-llvm-linux-x64-musl": "workspace:*",
    "@zshannon/scriptc-llvm-linux-arm64-musl": "workspace:*",
    "@zshannon/scriptc-llvm-win32-x64-msvc": "workspace:*",
    "@zshannon/scriptc-runtime-darwin-arm64": "workspace:*",
    "@zshannon/scriptc-runtime-darwin-x64": "workspace:*",
    "@zshannon/scriptc-runtime-linux-x64-gnu": "workspace:*",
    "@zshannon/scriptc-runtime-linux-arm64-gnu": "workspace:*",
    "@zshannon/scriptc-runtime-linux-x64-musl": "workspace:*",
    "@zshannon/scriptc-runtime-linux-arm64-musl": "workspace:*",
    "@zshannon/scriptc-runtime-win32-x64-msvc": "workspace:*",
    "@zshannon/scriptc-runtime-wasm32-wasi": "workspace:*",
    "@zshannon/scriptc-runtime-ios-arm64": "workspace:*",
    "@zshannon/scriptc-runtime-ios-simulator-arm64": "workspace:*",
    "@zshannon/scriptc-runtime-android-arm64": "workspace:*"
  }
}
